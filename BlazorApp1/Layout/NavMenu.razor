@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

@inject LocalizationService L
@implements IDisposable

<MudPaper Class="@NavClass" Elevation="0">
    <div class="nav-left">
        <MudIconButton Icon="@(IsDark? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       @onclick="HandleThemeToggleClick" />
    </div>

    <div class="nav-center">
        <MudLink Href="/" Class="@GetNavClass("/")">@Localizer["Work"]</MudLink>
        <MudLink Href="/about" Class="@GetNavClass("/about")">@Localizer["About"]</MudLink>
        <MudLink Href="/play" Class="@GetNavClass("/play")">@Localizer["Play"]</MudLink>
        <MudLink Href="/notes" Class="@GetNavClass("/notes")">@Localizer["Notes"]</MudLink>
        <MudLink Href="/contact" Class="@GetNavClass("/contact")">@Localizer["Contact"]</MudLink>
    </div>

    <div class="nav-right">
        <MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick="@(() => ChangeLanguage("en-US"))">
                @if (CurrentLang == "en-US")
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Class="mr-2" />
                }
                English
            </MudMenuItem>

            <MudMenuItem OnClick="@(() => ChangeLanguage("fa-IR"))">
                @if (CurrentLang == "fa-IR")
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Class="mr-2" />
                }
                فارسی
            </MudMenuItem>

            <MudMenuItem OnClick="@(() => ChangeLanguage("fr-FR"))">
                @if (CurrentLang == "fr-FR")
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Class="mr-2" />
                }
                French
            </MudMenuItem>
        </MudMenu>
    </div>
</MudPaper>

@code {
    [Parameter] public string NavClass { get; set; } = "";
    [Parameter] public string CurrentPath { get; set; } = "/";

    [Parameter] public bool IsDark { get; set; }

    [Parameter] public string CurrentLang { get; set; } = "en-US";
    [Parameter] public EventCallback<string> OnLanguageChanged { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnThemeToggleRequested { get; set; }

    protected override void OnInitialized()
    {
        L.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        L.OnChange -= StateHasChanged;
    }

    private string GetNavClass(string path)
    {
        var cleanCurrent = string.IsNullOrEmpty(CurrentPath) || CurrentPath == "/" ? "/" : CurrentPath;
        var cleanPath = string.IsNullOrEmpty(path) || path == "/" ? "/" : path;
        return cleanCurrent == cleanPath ? "nav-item active" : "nav-item";
    }

    private async Task ChangeLanguage(string lang)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "culture", lang);
        L.SetCulture(lang);
        await OnLanguageChanged.InvokeAsync(lang);
    }

    private async Task HandleThemeToggleClick(MouseEventArgs args)
    {
        // به جای تغییر مستقیم IsDark، مختصات کلیک رو به MainLayout می‌فرستیم
        await OnThemeToggleRequested.InvokeAsync(args);
    }
}