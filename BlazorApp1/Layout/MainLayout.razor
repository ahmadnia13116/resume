@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject LocalizationService L
@implements IDisposable

<MudThemeProvider @bind-IsDarkMode="_isDark" />

<MudContainer MaxWidth="MaxWidth.Large" Class="@($"main-container {(_isDark ? "dark-mode" : "")}")" dir="@(IsRTL ? "rtl" : "ltr")">
    <MudLayout>
        <NavMenu NavClass="@NavClass"
                 CurrentPath="@currentPath"
                 IsDark="_isDark"
                 CurrentLang="@L.CurrentCulture"
                 OnLanguageChanged="@HandleLanguageChange"
                 OnThemeToggleRequested="@HandleThemeToggle" />

        <MudMainContent Class="main-content">
            <MudContainer MaxWidth="MaxWidth.Large">
                
                @* 🔥 ترفند اصلی: استفاده از @key برای رفرش ریز کل @Body *@
                @* با تغییر زبان، مقدار @key عوض شده و بلیزر کل محتوای صفحه را Re-mount می‌کند *@
                <div @key="@L.CurrentCulture">
                    @Body
                </div>

                <!-- بخش دیباگ -->
                <div style="position:fixed; bottom:10px; right:10px; background:#333; color:#0f0; padding:10px; font-family:monospace; font-size:12px; z-index:9999;">
                    <div>Lang: @L.CurrentCulture</div>
                    <div>Culture: @System.Globalization.CultureInfo.CurrentCulture.Name</div>
                    <div>RTL: @IsRTL</div>
                    <div>Test: @L["Work"]</div>
                </div>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudContainer>

@code {
    private bool isScrolled = false;
    private string currentPath = "/";
    private bool _isDark = true;
    
    // 🔥 تغییر کلیدی ۱: به جای تعریف متغیر مستقل، مستقیماً از سرویس بخوانید
    // این کار باعث می‌شود همیشه مقدار به‌روز زبان را داشته باشید
    private string CurrentLang => L.CurrentCulture;

    private bool IsRTL => CurrentLang == "fa-IR" || CurrentLang == "ar-SA";

    private string NavClass => isScrolled
        ? "nav-menu nav-wrapper nav-glass"
        : "nav-menu nav-wrapper nav-transparent";

    private DotNetObjectReference<MainLayout>? dotNetRef;

    protected override void OnInitialized()
    {
        L.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        L.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        dotNetRef?.Dispose();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath(e.Location);
        StateHasChanged();
    }

    private void UpdateCurrentPath(string uri)
    {
        currentPath = Navigation.ToBaseRelativePath(uri);
        if (string.IsNullOrEmpty(currentPath)) currentPath = "/";
        else currentPath = "/" + currentPath;
    }

    // 🔥 تغییر کلیدی ۲: این متد دیگر نیازی به تغییر CurrentLang ندارد
    // چون CurrentLang الان یک Property است که مستقیماً از L.CurrentCulture می‌خواند
    private Task HandleLanguageChange(string newLang)
    {
        // فقط یک StateHasChanged اضافه برای اطمینان
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("addScrollListener", dotNetRef);
        }
    }

    [JSInvokable]
    public void UpdateNavOnScroll(double scrollY)
    {
        int scrollInt = Convert.ToInt32(scrollY);
        bool shouldBeScrolled = scrollInt > 50;

        if (shouldBeScrolled != isScrolled)
        {
            isScrolled = shouldBeScrolled;
            StateHasChanged();
        }
    }

    private async Task HandleThemeToggle(MouseEventArgs args)
    {
        await JSRuntime.InvokeVoidAsync("toggleThemeAnimation", args.ClientX, args.ClientY, !_isDark, dotNetRef);
    }

    [JSInvokable]
    public void CompleteThemeChange()
    {
        InvokeAsync(() =>
        {
            _isDark = !_isDark;
            StateHasChanged();
        });
    }
}