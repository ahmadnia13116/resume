            <MudLink href="https://github.com/ahmadnia-dev" Target="_blank" Class="card-link">
                github.com/ahmadnia-dev
            </MudLink>
        </MudPaper>

        <!-- LinkedIn -->
        <MudPaper Class="contact-card" Elevation="0">
            <div class="card-icon linkedin">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
            </div>
            <MudText Typo="Typo.subtitle1" Class="card-title">LinkedIn</MudText>
            <MudLink href="https://linkedin.com/in/ahmadnia" Target="_blank" Class="card-link">
                linkedin.com/in/ahmadnia
            </MudLink>
        </MudPaper>

        <!-- Phone -->
        <MudPaper Class="contact-card" Elevation="0">
            <div class="card-icon phone">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
                </svg>
            </div>
            <MudText Typo="Typo.subtitle1" Class="card-title">Phone</MudText>
            <MudLink href="tel:+989334455502" Class="card-link">
                +98 933 445 5502
            </MudLink>
        </MudPaper>

        <!-- WhatsApp -->
        <MudPaper Class="contact-card" Elevation="0">
            <div class="card-icon whatsapp">
                <svg viewBox="0 0 24 24" fill="currentColor">
