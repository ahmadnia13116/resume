            </div>
            <MudText Typo="Typo.subtitle1" Class="card-title">WhatsApp</MudText>
            <MudLink href="https://wa.me/989334455502" Target="_blank" Class="card-link">
                +98 933 445 5502
            </MudLink>
        </MudPaper>

        <!-- Telegram -->
        <MudPaper Class="contact-card" Elevation="0">
            <div class="card-icon telegram">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                </svg>
            </div>
            <MudText Typo="Typo.subtitle1" Class="card-title">Telegram</MudText>
            <MudLink href="https://t.me/ahmadnia_dev" Target="_blank" Class="card-link">
                ahmadnia_dev
            </MudLink>
        </MudPaper>

        <!-- Email -->
        <MudPaper Class="contact-card" Elevation="0">
            <div class="card-icon email">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
            </div>
            <MudText Typo="Typo.subtitle1" Class="card-title">Email</MudText>
            <MudLink href="mailto:hello@ahmadnia.dev" Class="card-link">
                hello@ahmadnia.dev
            </MudLink>
        </MudPaper>

        <!-- Location -->
        <MudPaper Class="contact-card contact-card-wide" Elevation="0">
            <div class="card-icon location">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
            </div>
            <MudText Typo="Typo.subtitle1" Class="card-title">Location</MudText>
            <MudText Typo="Typo.body2" Class="card-text">
                Tehran, Iran<br/>
                Vali-e-Asr Ave, Near Vanak Square
            </MudText>
        </MudPaper>
    </div>

    <!-- Stats Section -->
    <div class="stats-section">
        <div class="stat-item">
            <MudText Typo="Typo.h3" Class="stat-number">4+</MudText>
            <MudText Typo="Typo.body2" Class="stat-label">Years Experience</MudText>
        </div>
        <div class="stat-item">
            <MudText Typo="Typo.h3" Class="stat-number">50+</MudText>
            <MudText Typo="Typo.body2" Class="stat-label">Projects Completed</MudText>
        </div>
        <div class="stat-item">
            <MudText Typo="Typo.h3" Class="stat-number">30+</MudText>
            <MudText Typo="Typo.body2" Class="stat-label">Happy Clients</MudText>
        </div>
    </div>
</div>

<style>
    .about-container {
        padding: 40px 0;
    }

    .about-hero {
        text-align: center;
        margin-bottom: 60px;
    }

    .about-title {
        font-size: 64px !important;
        font-weight: 900 !important;
        color: #00695c !important;
        margin-bottom: 20px !important;
        letter-spacing: -1px;
    }

    .about-description {
        font-size: 18px !important;
        color: #636e72 !important;
        max-width: 600px;
        margin: 0 auto !important;
        line-height: 1.6;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 60px;
    }

    .contact-card {
        background: rgba(255, 255, 255, 0.6) !important;
        backdrop-filter: blur(10px);
        border-radius: 20px !important;
        padding: 30px;
        text-align: center;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.4);
        cursor: pointer;
    }

    .contact-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
        background: rgba(255, 255, 255, 0.8) !important;
    }

    .contact-card-wide {
        grid-column: span 3;
    }

    .card-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .card-icon svg {
        width: 30px;
        height: 30px;
    }

    .card-icon.github { background: #24292e; color: white; }
    .card-icon.linkedin { background: #0077b5; color: white; }
    .card-icon.phone { background: #00695c; color: white; }
    .card-icon.whatsapp { background: #25d366; color: white; }
    .card-icon.telegram { background: #0088cc; color: white; }
    .card-icon.email { background: #ea4335; color: white; }
    .card-icon.location { background: #00695c; color: white; }

    .card-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #2d3436 !important;
        margin-bottom: 10px !important;
    }

    .card-link {
        font-size: 14px !important;
        color: #00695c !important;
        text-decoration: none !important;
        transition: all 0.3s ease;
    }

    .card-link:hover {
        color: #004d40 !important;
        text-decoration: underline !important;
    }

    .card-text {
        font-size: 14px !important;
        color: #636e72 !important;
        line-height: 1.6;
    }

    .stats-section {
        display: flex;
        justify-content: center;
        gap: 80px;
        padding: 60px 0;
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

    .stat-item {
        text-align: center;
    }

    .stat-number {
        font-size: 48px !important;
        font-weight: 900 !important;
        color: #00695c !important;
        margin-bottom: 10px !important;
    }

    .stat-label {
        font-size: 14px !important;
        color: #636e72 !important;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    @@media (max-width: 968px) {
        .contact-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .contact-card-wide {
            grid-column: span 2;
        }
        .stats-section {
            gap: 40px;
        }
    }

    @@media (max-width: 640px) {
        .about-title {
            font-size: 48px !important;
        }
        .contact-grid {
            grid-template-columns: 1fr;
        }
        .contact-card-wide {
            grid-column: span 1;
        }
        .stats-section {
            flex-direction: column;
            gap: 30px;
        }
        .stat-number {
            font-size: 36px !important;
        }
    }
</style>