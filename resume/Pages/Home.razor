@page "/"
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
@inject LocalizationService L

<!-- Hero Section -->
<div class="hero-section">
    <div class="star-icon">
        <svg viewBox="0 0 100 100" fill="white">
            <path d="M50 0 L60 40 L100 50 L60 60 L50 100 L40 60 L0 50 L40 40 Z" />
        </svg>
    </div>
        
    <MudText Typo="Typo.h1" Class="hero-title">@L["MyName"]</MudText>
    <MudText Typo="Typo.h1" Class="hero-subtitle">@Localizer["Job"]</MudText>
        
    <MudText Typo="Typo.body1" Class="hero-description">
        I'm passionate about crafting experiences that are engaging, accessible, and user-centric.
    </MudText>
</div>

<!-- Cards Section -->
<div class="cards-grid">
    <MudPaper Class="card card-purple" Elevation="0">
        <MudText Typo="Typo.caption" Class="card-label">HELP SCOUT</MudText>
        <MudText Typo="Typo.h3" Class="card-title">AI</MudText>
        <div class="card-footer"></div>
    </MudPaper>

    <MudPaper Class="card card-teal" Elevation="0">
        <MudText Typo="Typo.caption" Class="card-label">HELP SCOUT</MudText>
        <MudText Typo="Typo.h3" Class="card-title">Articles</MudText>
        <div class="card-footer"></div>
    </MudPaper>
</div>

<!-- Cards Section -->
<div class="cards-grid">
    <MudPaper Class="card card-purple" Elevation="0">
        <MudText Typo="Typo.caption" Class="card-label">HELP SCOUT</MudText>
        <MudText Typo="Typo.h3" Class="card-title">AI</MudText>
        <div class="card-footer"></div>
    </MudPaper>

    <MudPaper Class="card card-teal" Elevation="0">
        <MudText Typo="Typo.caption" Class="card-label">HELP SCOUT</MudText>
        <MudText Typo="Typo.h3" Class="card-title">Articles</MudText>
        <div class="card-footer"></div>
    </MudPaper>
</div>

<!-- Extra content for scroll demo -->
<div class="extra-content">
    <MudText Typo="Typo.h4">More Content Here</MudText>
    <MudText Typo="Typo.body1">Scroll down to see the sticky glass navigation effect.</MudText>
</div>